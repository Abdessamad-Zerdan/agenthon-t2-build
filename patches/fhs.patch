+def _fhs_cumulative(
+    X: np.ndarray, horizons: list[int], n_draws: int, rng: np.random.Generator,
+    *, lam: float = 0.97, rho: float = 0.985, win: int = 2500, infl: float = 1.0,
+) -> np.ndarray:
+    """Filtered historical simulation of cumulative step sums, shape (n_draws, assets, horizons).
+
+    Each asset's volatility follows an EWMA filter and mean-reverts to its long-run level along
+    the horizon; whole historical days of standardised shocks are resampled jointly, so
+    cross-asset dependence and fat tails are kept. Fitted only on rows up to the as-of.
+    """
+    n_obs, n_assets = X.shape
+    vv = np.var(X[:60], axis=0) + 1e-18
+    sig_t = np.empty_like(X)
+    for t in range(n_obs):
+        sig_t[t] = np.sqrt(vv)
+        vv = lam * vv + (1.0 - lam) * X[t] * X[t]
+    long_run = X[-win:].var(axis=0) + 1e-18
+    hmax = int(max(horizons))
+    k = np.arange(1, hmax + 1)[:, None]
+    sigp = np.sqrt(np.clip(long_run + (vv - long_run) * rho**k, 1e-18, None)) * infl
+    z = (X / sig_t)[-win:]
+    z = (z - z.mean(axis=0)) / np.where(z.std(axis=0) > 0, z.std(axis=0), 1.0)
+    idx = rng.integers(0, len(z), size=(n_draws, hmax))
+    cum = np.cumsum(z[idx] * sigp[None], axis=1)
+    return np.stack([cum[:, h - 1, :] for h in horizons], axis=2)
+
+
