@@ -0,0 +1,149 @@
+"""Optional text reading through the House model.
+
+One request per unit. The model reads the card's own description and the most recent documents
+in its dated corpus (all timestamped at or before the as-of) and returns a small, bounded view:
+
+* ``spread_mult`` in [0.85, 1.30]: how much more (or less) uncertain the next weeks look than
+  the numeric history alone suggests.
+* ``tilt`` per asset in [-1, 1]: the direction the documents point, scaled by confidence.
+
+The forecaster applies the view with hard caps (see ``cli.TILT_SD``): a wrong reading can move a
+centre by at most a quarter of a standard deviation. Any failure -- no House route, a refused or
+slow request, unparseable output -- returns ``None`` and the forecast is the numeric one.
+"""
+from __future__ import annotations
+
+import json
+import os
+import pathlib
+import re
+import urllib.request
+from typing import Any
+
+MAX_DOC_CHARS = 2500
+MAX_CORPUS_CHARS = 16000
+TIMEOUT_S = 120
+RISK_TO_SPREAD = {"low": 0.9, "medium": 1.0, "high": 1.2}
+
+
+def _corpus(text_dir: pathlib.Path) -> list[tuple[str, str, str]]:
+    """(timestamp, doc_id, excerpt), newest first."""
+    docs: list[tuple[str, str, str]] = []
+    index = text_dir / "corpus_index.json"
+    entries: list[dict[str, Any]] = []
+    if index.exists():
+        try:
+            entries = list(json.loads(index.read_text(encoding="utf-8")).get("documents", []))
+        except (ValueError, OSError):
+            entries = []
+    if not entries:
+        entries = [{"file": p.name, "doc_id": p.stem, "timestamp": ""} for p in text_dir.glob("*.txt")]
+    for e in entries:
+        p = text_dir / str(e.get("file", ""))
+        if not p.is_file():
+            continue
+        try:
+            body = p.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        body = re.sub(r"\s+", " ", body).strip()[:MAX_DOC_CHARS]
+        docs.append((str(e.get("timestamp", "")), str(e.get("doc_id", p.stem)), body))
+    docs.sort(key=lambda d: d[0], reverse=True)
+    return docs
+
+
+def _prompt(card: dict[str, Any], docs, assets, horizons, asof, recent: dict[str, str]) -> str:
+    meta = card.get("metadata", {})
+    text_note = card.get("text", {}).get("notes", "")
+    parts = [
+        f"Forecast date (as-of): {asof}. You must reason ONLY from the documents below, all dated "
+        f"on or before {asof}. Do not use any knowledge of what happened after {asof}.",
+        f"Task: {card.get('task', {}).get('title', '')}",
+        f"Description: {meta.get('description', '')}",
+        f"Corpus note: {text_note}",
+        f"Targets: {', '.join(assets)} at horizons {horizons} business days ahead.",
+        "Recent behaviour of each target series (value as quoted in the data):",
+        *[f"- {a}: {recent.get(a, '')}" for a in assets],
+        "",
+        "Documents (newest first, excerpts):",
+    ]
+    used = 0
+    for ts, doc_id, body in docs:
+        if used + len(body) > MAX_CORPUS_CHARS:
+            break
+        parts.append(f"[{ts}] {doc_id}: {body}")
+        used += len(body)
+    parts += [
+        "",
+        "Answer with one JSON object and nothing else:",
+        '{"risk": "low|medium|high", "direction": {"<asset>": <number from -1 to 1>, ...}, '
+        '"confidence": <number from 0 to 1>, "evidence": ["<doc_id>: <short reason>", ...]}',
+        "risk = how likely a larger-than-usual move is over the horizon, judged from the documents.",
+        "direction = whether each series' quoted value is more likely to end higher (+) or lower (-);"
+        " use 0 when the documents do not point either way.",
+    ]
+    return "\n".join(parts)
+
+
+def _call(prompt: str) -> str | None:
+    endpoint = os.environ.get("MODEL_ENDPOINT")
+    token = os.environ.get("MODEL_TOKEN")
+    name = os.environ.get("MODEL_NAME")
+    if not (endpoint and token and name):
+        return None
+    body = json.dumps({
+        "model": name,
+        "messages": [
+            {"role": "system", "content": "You are a careful macro analyst. Output strict JSON."},
+            {"role": "user", "content": prompt},
+        ],
+        "max_tokens": 700,
+        "temperature": 0,
+        "chat_template_kwargs": {"enable_thinking": False},
+    }).encode()
+    req = urllib.request.Request(
+        endpoint.rstrip("/") + "/v1/chat/completions",
+        data=body,
+        headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
+        method="POST",
+    )
+    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:  # proxies come from the environment
+        out = json.loads(r.read().decode("utf-8"))
+    return str(out["choices"][0]["message"]["content"])
+
+
+def _parse(raw: str, assets: list[str]) -> dict[str, Any] | None:
+    m = re.search(r"\{.*\}", raw, re.S)
+    if not m:
+        return None
+    obj = json.loads(m.group(0))
+    risk = str(obj.get("risk", "medium")).lower().strip()
+    conf = min(max(float(obj.get("confidence", 0.0)), 0.0), 1.0)
+    direction = obj.get("direction", {}) or {}
+    tilt = {}
+    for a in assets:
+        try:
+            v = float(direction.get(a, 0.0))
+        except (TypeError, ValueError):
+            v = 0.0
+        tilt[a] = min(max(v, -1.0), 1.0) * conf
+    spread = RISK_TO_SPREAD.get(risk, 1.0)
+    evidence = [str(e)[:200] for e in (obj.get("evidence") or [])][:6]
+    return {"spread_mult": min(max(spread, 0.85), 1.30), "tilt": tilt, "risk": risk,
+            "confidence": conf, "evidence": evidence}
+
+
+def text_view(card, text_dir, assets, horizons, asof, recent) -> dict[str, Any] | None:
+    try:
+        text_dir = pathlib.Path(text_dir)
+        if not text_dir.is_dir():
+            return None
+        docs = _corpus(text_dir)
+        if not docs:
+            return None
+        raw = _call(_prompt(card, docs, assets, horizons, asof, recent))
+        if raw is None:
+            return None
+        return _parse(raw, assets)
+    except Exception:  # never let the optional text step break a forecast
+        return None
